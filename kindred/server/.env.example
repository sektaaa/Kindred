PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/kindred
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
NODE_ENV=development
# Default admin (created automatically if no admin exists). Change the password after first login.
ADMIN_EMAIL=admin@kindred.app
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Kindred Admin
